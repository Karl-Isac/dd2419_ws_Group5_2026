<?xml version="1.0"?>
<launch>
	<node pkg="rviz2" exec="rviz2" name="rviz" output="screen">
		<param name="use_sim_time" value="true"/>
	</node>

	<node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
		<param name="use_sim_time" value="true"/>
		<param name="robot_description" value="$(command 'xacro $(find-pkg-share realsense2_description)/urdf/test_d435_camera.urdf.xacro use_nominal_extrinsics:=false')"/>
		<param name="publish_frequency" value="30.0" />
	</node>

	<node name="lidar_static_tf" pkg="tf2_ros" exec="static_transform_publisher"
		args="--x 0.0 --y -0.09 --z 0.0 --frame-id base_link --child-frame-id lidar_link">
		<param name="use_sim_time" value="true"/>
	</node>

	<node pkg="mapping" exec="space" name="make_space" output="screen">
		<param name="use_sim_time" value="true"/>
	</node>

	<node pkg="mapping" exec="stuff" name="place_stuff" output="screen">
		<param name="use_sim_time" value="true"/>
	</node>

	<node pkg="odometry" exec="odometry" name="odometry" output="screen">
		<param name="use_sim_time" value="true"/>
	</node>

	<!--<node pkg="odometry" exec="ICP" name="ICP" output="screen">
		<param name="use_sim_time" value="true"/>
	</node>-->
</launch>